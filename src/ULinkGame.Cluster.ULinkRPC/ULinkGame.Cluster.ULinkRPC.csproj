<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ULinkGame.Cluster.ULinkRPC</RootNamespace>
    <PackageId>ULinkGame.Cluster.ULinkRPC</PackageId>
    <Version>0.1.3</Version>
    <Description>ULinkRPC-based node messenger adapter for ULinkGame cluster routing.</Description>
    <PackageTags>ulinkgame;game;cluster;routing;ulinkrpc</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ULinkGame.Cluster\ULinkGame.Cluster.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ULinkRPC.Client" Version="0.12.0" />
    <PackageReference Include="ULinkRPC.Server" Version="0.12.1" />
    <PackageReference Include="ULinkRPC.Transport.Tcp" Version="0.11.4" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
