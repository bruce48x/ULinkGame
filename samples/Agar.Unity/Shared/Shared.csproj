  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Shared</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MemoryPack.UnityShims" Version="1.21.4" />
    <PackageReference Include="ULinkRPC.Core" Version="0.11.8" />
    <PackageReference Include="ULinkRPC.Serializer.MemoryPack" Version="0.11.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="../../../src/ULinkGame.Server.Hotfix.Abstractions/ULinkGame.Server.Hotfix.Abstractions.csproj" />
    <ProjectReference Include="../../../src/ULinkGame.Server.Hotfix/ULinkGame.Server.Hotfix.csproj" />
    <ProjectReference Include="../../../src/ULinkGame.Server.Hotfix.Generators/ULinkGame.Server.Hotfix.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>
</Project>
